{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Forseti",
  "version": "0.1.0",
  "identifier": "com.norika.forseti",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "default",
          "description": "Forseti 前端需要的權限。core:default 涵蓋 invoke 與 event。",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:default"
          ]
        }
      ]
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.png"
    ]
  }
}