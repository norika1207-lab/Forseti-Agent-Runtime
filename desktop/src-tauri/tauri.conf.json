{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Forseti",
  "version": "0.1.0",
  "identifier": "com.norika.forseti",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "Forseti",
        "width": 1440,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 680,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.png"]
  }
}
